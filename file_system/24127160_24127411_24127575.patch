diff --git a/kernel/fs.c b/kernel/fs.c
index c6bab15..a0dbc44 100644
--- a/kernel/fs.c
+++ b/kernel/fs.c
@@ -417,6 +417,45 @@ bmap(struct inode *ip, uint bn)
     return addr;
   }
 
+  bn -= NINDIRECT;
+
+  // === Phần 3: Doubly-indirect blocks (bn = 0..65535) ===
+  if(bn < NINDIRECT * NINDIRECT){
+    // Bước 3a: Load doubly-indirect block
+    if((addr = ip->addrs[NDIRECT+1]) == 0){
+      addr = balloc(ip->dev);
+      if(addr == 0)
+        return 0;
+      ip->addrs[NDIRECT+1] = addr;
+    }
+    bp = bread(ip->dev, addr);
+    a = (uint*)bp->data;
+
+    // Bước 3b: Tìm singly-indirect block bên trong (chia lấy nguyên)
+    if((addr = a[bn / NINDIRECT]) == 0){
+      addr = balloc(ip->dev);
+      if(addr){
+        a[bn / NINDIRECT] = addr;
+        log_write(bp);
+      }
+    }
+    brelse(bp);
+
+    // Bước 3c: Load singly-indirect block và tìm data block thật (chia lấy dư)
+    if(addr == 0)
+      return 0;
+    bp = bread(ip->dev, addr);
+    a = (uint*)bp->data;
+    if((addr = a[bn % NINDIRECT]) == 0){
+      addr = balloc(ip->dev);
+      if(addr){
+        a[bn % NINDIRECT] = addr;
+        log_write(bp);
+      }
+    }
+    brelse(bp);
+    return addr;
+  }
   panic("bmap: out of range");
 }
 
